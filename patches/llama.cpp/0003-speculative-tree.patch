+void llama_kv_cache::tree_add(const slot_info & sinfo, const llama_ubatch & ubatch) {
+    if (!ubatch.parent) {
+        return;
+    }
+
+    GGML_ASSERT(sinfo.n_stream() == 1 && ubatch.n_seqs_unq == 1 && "a draft tree holds one sequence");
+
+    const llama_seq_id seq_id = ubatch.seq_id[0][0];
+
+    auto & tree = trees[seq_id];
+
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        const int32_t parent = ubatch.parent[i];
+        GGML_ASSERT(parent >= -1 && parent < (int32_t) tree.size() && "a tree node comes after its parent");
+        tree.push_back({ sinfo.idxs[0][i], parent });
+    }
+}
