index 0000000..0808b40
--- /dev/null
+++ b/examples/tree-verify/tree-verify.cpp
@@ -0,0 +1,174 @@
+// Checks draft-tree verification against plain greedy decoding on one model.
+//
+// Greedy decodes n tokens one at a time, then decodes again verifying trees built around that
+// continuation: each tree mixes the true next tokens with wrong siblings, in shuffled order, and
+// one branch goes wrong partway down. The tree run must reproduce the greedy tokens exactly.
+
+#include "llama.h"
+#include "../src/llama-ext.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static llama_token argmax(llama_context * ctx, int32_t i, int32_t n_vocab) {
+    const float * logits = llama_get_logits_ith(ctx, i);
+    return (llama_token) (std::max_element(logits, logits + n_vocab) - logits);
+}
+
+static llama_context * make_ctx(llama_model * model, uint32_t n_rs_seq) {
+    auto cparams = llama_context_default_params();
+    cparams.n_ctx     = 4096;
+    cparams.n_batch   = 512;
+    cparams.n_ubatch  = 512;
+    cparams.n_seq_max = 1;
+    cparams.n_rs_seq  = n_rs_seq;
+    return llama_init_from_model(model, cparams);
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2) {
+        fprintf(stderr, "usage: %s MODEL.gguf [n_predict] [prompt] [max_nodes]\n", argv[0]);
+        return 2;
+    }
+
+    const std::string path      = argv[1];
+    const int         n_predict = argc > 2 ? atoi(argv[2]) : 128;
+    const std::string prompt    = argc > 3 ? argv[3] : "Write a short story about a lighthouse keeper who finds a map.";
+    const int         max_nodes = argc > 4 ? atoi(argv[4]) : 12;
+
+    llama_backend_init();
+
+    auto mparams = llama_model_default_params();
+    llama_model * model = llama_model_load_from_file(path.c_str(), mparams);
+    if (!model) {
+        return 1;
+    }
+
+    const llama_vocab * vocab   = llama_model_get_vocab(model);
+    const int32_t       n_vocab = llama_vocab_n_tokens(vocab);
+
+    std::vector<llama_token> toks(prompt.size() + 16);
+    const int n_prompt = llama_tokenize(vocab, prompt.c_str(), prompt.size(), toks.data(), toks.size(), true, true);
+    toks.resize(n_prompt);
+
+    // plain greedy
+    std::vector<llama_token> want;
+    {
+        llama_context * ctx = make_ctx(model, 0);
+        llama_decode(ctx, llama_batch_get_one(toks.data(), n_prompt));
+        llama_token t = argmax(ctx, -1, n_vocab);
+        for (int i = 0; i < n_predict; ++i) {
+            want.push_back(t);
+            llama_decode(ctx, llama_batch_get_one(&t, 1));
+            t = argmax(ctx, -1, n_vocab);
+        }
+        want.push_back(t);
+        llama_free(ctx);
+    }
+
+    // tree verification
+    llama_context * ctx = make_ctx(model, max_nodes - 1);
+    llama_decode(ctx, llama_batch_get_one(toks.data(), n_prompt));
+
+    std::mt19937 rng(1234);
+    std::vector<llama_token> got;
+    llama_token root = argmax(ctx, -1, n_vocab);
+    llama_pos   base = n_prompt;
+    int passes = 0;
+
+    llama_batch batch = llama_batch_init(max_nodes, 0, 1);
+
+    while ((int) got.size() < n_predict) {
+        const size_t at = got.size();
+
+        // nodes in depth order: the true chain, a wrong sibling at every depth, and a branch that goes wrong
+        std::vector<llama_token> tok   = { root };
+        std::vector<int32_t>     par   = { -1 };
+        std::vector<int32_t>     depth = { 0 };
+        const int wrong_at = std::uniform_int_distribution<int>(1, 6)(rng);
+        int32_t true_node = 0;
+        for (int d = 1; (int) tok.size() + 2 <= max_nodes && at + d < want.size(); ++d) {
+            llama_token right = want[at + d];
+            if (d == wrong_at) {
+                right = (right + 7) % n_vocab;
+            }
+            llama_token sibling = (want[at + d] + 1 + d) % n_vocab;
+            const bool swap = std::uniform_int_distribution<int>(0, 1)(rng) == 1;
+            int32_t parent = true_node;
+            for (int k = 0; k < 2; ++k) {
+                const bool is_true = (k == 0) != swap;
+                tok.push_back(is_true ? right : sibling);
+                par.push_back(parent);
+                depth.push_back(d);
+                if (is_true) {
+                    true_node = (int32_t) tok.size() - 1;
+                }
+            }
+        }
+
+        batch.n_tokens = 0;
+        for (size_t n = 0; n < tok.size(); ++n) {
+            batch.token   [n]    = tok[n];
+            batch.pos     [n]    = base + depth[n];
+            batch.n_seq_id[n]    = 1;
+            batch.seq_id  [n][0] = 0;
+            batch.logits  [n]    = true;
+            batch.n_tokens++;
+        }
+
+        llama_set_tree(ctx, par.data(), (int32_t) par.size());
+        if (llama_decode(ctx, batch) != 0) {
+            fprintf(stderr, "decode failed\n");
+            return 1;
+        }
+        passes++;
+
+        std::vector<int32_t> path = { 0 };
+        llama_token next = argmax(ctx, 0, n_vocab);
+        while (true) {
+            int32_t child = -1;
+            for (size_t n = 1; n < tok.size(); ++n) {
+                if (par[n] == path.back() && tok[n] == next) {
+                    child = (int32_t) n;
+                    break;
+                }
+            }
+            got.push_back(next);
+            if (child < 0) {
+                break;
+            }
+            path.push_back(child);
+            next = argmax(ctx, child, n_vocab);
+        }
+
+        if (!llama_tree_commit(ctx, 0, path.data(), (int32_t) path.size())) {
+            fprintf(stderr, "commit failed\n");
+            return 1;
+        }
+
+        base += (llama_pos) path.size();
+        root  = got.back();
+    }
+
+    got.resize(n_predict);
+    int first_diff = -1;
+    for (int i = 0; i < n_predict; ++i) {
+        if (got[i] != want[i + 1] && first_diff < 0) {
+            first_diff = i;
+        }
+    }
+
+    printf("tokens %d, passes %d, tokens/pass %.2f, first difference %d\n",
+            n_predict, passes, (double) n_predict / passes, first_diff);
+
+    llama_batch_free(batch);
+    llama_free(ctx);
+    llama_model_free(model);
+
+    return first_diff < 0 ? 0 : 3;
+}
