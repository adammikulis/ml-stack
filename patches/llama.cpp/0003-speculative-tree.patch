+void llama_memory_recurrent::tree_add(const llama_ubatch & ubatch) {
+    if (!ubatch.parent) {
+        return;
+    }
+
+    GGML_ASSERT(ubatch.n_seqs == 1 && ubatch.n_seqs_unq == 1 && "a draft tree holds one sequence");
+    GGML_ASSERT(ubatch.n_tokens <= n_rs_seq + 1 && "a draft tree on a recurrent memory needs n_rs_seq >= n_nodes - 1");
+
+    const llama_seq_id seq_id = ubatch.seq_id[0][0];
+
+    auto & tp = tree_pos[seq_id];
+    GGML_ASSERT(tp.empty() && "a draft tree on a recurrent memory is decoded in one batch and committed before the next");
+
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        GGML_ASSERT(ubatch.parent[i] >= -1 && ubatch.parent[i] < (int32_t) i);
+        tp.push_back(ubatch.pos[i]);
+    }
+}
+
+bool llama_memory_recurrent::tree_commit(llama_seq_id seq_id, const int32_t * path, int32_t n_path) {
+    GGML_ASSERT(seq_id >= 0 && (uint32_t) seq_id < n_seq_max);
+
+    auto & tp = tree_pos[seq_id];
+
+    if (tp.empty() || n_path <= 0) {
+        LLAMA_LOG_ERROR("%s: seq_id %d has no tree to keep a path of\n", __func__, seq_id);
+        return false;
+    }
+
+    const int32_t n_nodes = (int32_t) tp.size();
+    const int32_t last    = path[n_path - 1];
+
+    if (last < 0 || last >= n_nodes) {
+        LLAMA_LOG_ERROR("%s: path node %d is not in the tree of %d nodes\n", __func__, last, n_nodes);
+        return false;
+    }
+
+    const int32_t tail_id = cells[seq_id].tail;
+    GGML_ASSERT(tail_id >= 0);
+
+    set_rs_idx(seq_id, (uint32_t) (n_nodes - 1 - last));
+    cells[tail_id].pos = tp[last];
+
+    tp.clear();
+
+    return true;
+}
