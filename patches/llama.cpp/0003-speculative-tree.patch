+llm_graph_input_tree * llm_build_delta_net_base::build_inp_tree(int64_t conv_kernel_size, uint32_t kv_head, uint32_t mem_size) {
+    if (inp_tree) {
+        return inp_tree;
+    }
+
+    GGML_ASSERT(ubatch.parent && ubatch.n_seqs == 1);
+
+    const int32_t N   = (int32_t) ubatch.n_tokens;
+    const int32_t pad = (int32_t) conv_kernel_size - 1;
+
+    auto inp = std::make_unique<llm_graph_input_tree>();
+
+    std::vector<int32_t> depth(N, 0);
+    for (int32_t n = 0; n < N; ++n) {
+        const int32_t p = ubatch.parent[n];
+        GGML_ASSERT(p >= -1 && p < n);
+        depth[n] = p < 0 ? 0 : depth[p] + 1;
+        inp->n_iter = std::max(inp->n_iter, depth[n] + 1);
+        inp->parent_data.push_back(p + 1);
+        inp->dst_data.push_back((int64_t) (N - 1 - n) * mem_size + kv_head);
+    }
+
+    for (int32_t n = 0; n < N; ++n) {
+        for (int32_t s = pad; s >= 0; --s) {
+            int32_t node = n;
+            int32_t up   = 0;
+            while (up < s && node >= 0) {
+                node = ubatch.parent[node];
+                up++;
+            }
+            // s steps back is a node on the path, or the (s - depth - 1)-th row before the root
+            inp->taps_data.push_back(node >= 0 ? pad + node : pad - (s - depth[n]));
+        }
+    }
+
+    inp->parent_rows = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, N);
+    inp->conv_taps   = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, (int64_t) N * conv_kernel_size);
+    inp->state_dst   = ggml_new_tensor_1d(ctx0, GGML_TYPE_I64, N);
+    ggml_set_input(inp->parent_rows);
+    ggml_set_input(inp->conv_taps);
+    ggml_set_input(inp->state_dst);
+
+    inp_tree = static_cast<llm_graph_input_tree *>(res->add_input(std::move(inp)));
+
+    return inp_tree;
+}
