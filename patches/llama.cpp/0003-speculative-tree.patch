+void llama_kv_cache::tree_forget(llama_seq_id seq_id, llama_pos p0, llama_pos p1) {
+    auto & tree = trees[seq_id];
+    if (tree.empty()) {
+        return;
+    }
+
+    const auto & cells = v_cells[seq_to_stream[seq_id]];
+
+    uint32_t n_in = 0;
+    for (const auto & node : tree) {
+        if (cells.pos_in(node.cell, p0, p1)) {
+            n_in++;
