+
+bool llama_kv_cache::tree_commit(llama_seq_id seq_id, const int32_t * path, int32_t n_path) {
+    if (other) {
+        return true;
+    }
+
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+
+    auto & tree  = trees[seq_id];
+    auto & cells = v_cells[seq_to_stream[seq_id]];
+    auto & head  = v_heads[seq_to_stream[seq_id]];
+
+    std::vector<bool> keep(tree.size(), false);
+    for (int32_t t = 0; t < n_path; ++t) {
+        const int32_t node = path[t];
+        if (node < 0 || node >= (int32_t) tree.size()) {
+            LLAMA_LOG_ERROR("%s: path node %d is not in the tree of %zu nodes\n", __func__, node, tree.size());
+            return false;
+        }
+        if (tree[node].parent != (t == 0 ? -1 : path[t - 1])) {
+            LLAMA_LOG_ERROR("%s: path node %d does not descend from the node before it\n", __func__, node);
+            return false;
+        }
+        keep[node] = true;
+    }
+
+    uint32_t new_head = cells.size();
+
+    for (size_t k = 0; k < tree.size(); ++k) {
+        const uint32_t idx = tree[k].cell;
+        if (keep[k] || !cells.seq_has(idx, seq_id)) {
+            continue;
+        }
+        if (cells.seq_rm(idx, seq_id) && idx < new_head) {
+            new_head = idx;
+        }
+    }
+
+    if (new_head != cells.size() && new_head < head) {
+        head = new_head;
+    }
+
+    tree.clear();
+
+    return true;
+}
