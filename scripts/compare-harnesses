#!/usr/bin/env python3
"""Run one small bug-fix task through Claude Code, Codex and ml-stack's own agent on the same served model.

    scripts/compare-harnesses --model Qwen3.5-2B [--ctx 262144] [--out docs/experiments/harness-comparison.md]
    scripts/compare-harnesses --on http://127.0.0.1:8080 --dry-run

The fixture is tests/fixtures/toy_bugfix (its test is stored as check_calc.py so the suite does not collect it), copied to a temporary git repository per run and scored
by its own test. Every harness is the launcher this repository ships (`ml-stack-claude`,
`ml-stack-codex`), pointed at one server, so the model, the slot and the cache are shared and the
rows are comparable. A first call per harness with a one-line prompt measures the prompt prefix
(system prompt and tool list) the harness sends. The row records wall time, the tokens the server
processed, the tokens the harness says it sent and how many came from the cache, tool calls and the
fixture's test result. A harness that is not installed, or an agent loop that has not landed, is
reported as skipped. Flash-Next is refused.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from collections.abc import Sequence
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FIXTURE = ROOT / "tests" / "fixtures" / "toy_bugfix"
TASK = ("The test in this directory fails. Run `python -m pytest -q`, find the bug in calc.py, "
        "fix it, and run the test again. Change nothing else.")
PREFIX = "Reply with the single word ready. Do not use any tool."
COUNTERS = {"prompt_tokens_total": "processed", "tokens_predicted_total": "generated",
            "prompt_seconds_total": "prompt_s", "tokens_predicted_seconds_total": "generate_s"}
TIMEOUT_S = 1800


def scrape(base_url: str) -> dict[str, float]:
    """The llama-server /metrics counters this report uses; empty when the server has none."""
    try:
        with urllib.request.urlopen(base_url.rstrip("/") + "/metrics", timeout=10) as reply:  # noqa: S310
            text = reply.read().decode("utf-8", "replace")
    except OSError:
        return {}
    found: dict[str, float] = {}
    for line in text.splitlines():
        match = re.match(r"llamacpp:(\w+)\s+([0-9.eE+-]+)$", line.strip())
        if match and match.group(1) in COUNTERS:
            found[COUNTERS[match.group(1)]] = float(match.group(2))
    return found


def parse_claude(stdout: str) -> dict[str, int]:
    """Tool calls and token usage from ``claude -p --output-format stream-json --verbose``."""
    calls = sent = cached = 0
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("type") == "assistant":
            for part in (event.get("message") or {}).get("content") or []:
                calls += part.get("type") == "tool_use"
        if event.get("type") == "result":
            usage = event.get("usage") or {}
            cached = int(usage.get("cache_read_input_tokens") or 0)
            sent = int(usage.get("input_tokens") or 0) + cached + int(usage.get("cache_creation_input_tokens") or 0)
    return {"tool_calls": calls, "input_tokens": sent, "cached_tokens": cached}


def parse_codex(stdout: str) -> dict[str, int]:
    """Tool calls and token usage from ``codex exec --json``."""
    calls = sent = cached = 0
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        item = event.get("item") or {}
        if event.get("type") == "item.completed" and item.get("type") in (
                "command_execution", "file_change", "mcp_tool_call"):
            calls += 1
        if event.get("type") == "turn.completed":
            usage = event.get("usage") or {}
            sent += int(usage.get("input_tokens") or 0)
            cached += int(usage.get("cached_input_tokens") or 0)
    return {"tool_calls": calls, "input_tokens": sent, "cached_tokens": cached}


def workdir() -> Path:
    """A fresh git repository holding the fixture."""
    where = Path(tempfile.mkdtemp(prefix="harness-fixture-")) / "task"
    shutil.copytree(FIXTURE, where, ignore=shutil.ignore_patterns("__pycache__", ".pytest_cache"))
    (where / "check_calc.py").rename(where / "test_calc.py")
    for words in (["init", "-q"], ["add", "."], ["-c", "user.name=t", "-c", "user.email=t@example.invalid",
                                                   "commit", "-q", "-m", "fixture"]):
        subprocess.run(["git", *words], cwd=where, check=True, capture_output=True)
    return where


def passes(where: Path) -> bool:
    done = subprocess.run([sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider"], cwd=where,
                          capture_output=True, text=True, check=False, timeout=120)
    return done.returncode == 0


def harnesses(base_url: str, ctx: int) -> dict[str, tuple[list[str], list[str], object]]:
    """``name -> (probe command, task command, output parser)`` for each harness."""
    def claude(prompt: str) -> list[str]:
        return [sys.executable, "-m", "ml_stack.claude", "--on", base_url, "--role", "plan-and-go", "--ctx", str(ctx), "--",
                "-p", prompt, "--output-format", "stream-json", "--verbose"]

    def codex(prompt: str) -> list[str]:
        return [sys.executable, "-m", "ml_stack.codex", "--on", base_url, "--role", "plan-and-go", "--ctx", str(ctx), "--",
                "exec", "--json", "--skip-git-repo-check", prompt]

    return {"claude-code": (claude(PREFIX), claude(TASK), parse_claude),
            "codex": (codex(PREFIX), codex(TASK), parse_codex)}


def own_agent_present() -> bool:
    """Whether ml-stack's own agent loop (`ml-stack-workspace agent`) is on this branch."""
    exe = shutil.which("ml-stack-workspace")
    if not exe:
        return False
    done = subprocess.run([exe, "agent", "--help"], capture_output=True, text=True, check=False)
    return done.returncode == 0


def measure(name: str, command: list[str], parser, base_url: str, where: Path) -> dict[str, object]:
    """Run ``command`` in ``where`` and return one row."""
    before, began = scrape(base_url), time.monotonic()
    try:
        done = subprocess.run(command, cwd=where, capture_output=True, text=True, check=False,
                              timeout=TIMEOUT_S, env={**os.environ, "ML_STACK_NO_REAL_KEYSTORE": "1", "PYTHONPATH": str(ROOT / "src")})
        out, code = done.stdout, done.returncode
    except subprocess.TimeoutExpired:
        out, code = "", -1
    wall = time.monotonic() - began
    after = scrape(base_url)
    row: dict[str, object] = {"harness": name, "exit": code, "wall_s": round(wall, 1),
                              **parser(out), "pass": passes(where)}
    row["processed_tokens"] = int(after.get("processed", 0) - before.get("processed", 0)) if after else None
    row["generated_tokens"] = int(after.get("generated", 0) - before.get("generated", 0)) if after else None
    sent = int(row.get("input_tokens") or 0)
    row["cache_hit_ratio"] = (round(1 - row["processed_tokens"] / sent, 3)
                              if sent and row["processed_tokens"] is not None else None)
    return row


def probe(command: list[str], parser, base_url: str) -> dict[str, object]:
    """The first-turn cost of a harness: what one call with no tool use sends and the server processes."""
    where = workdir()
    row = measure("probe", command, parser, base_url, where)
    return {"first_turn_input_tokens": row.get("input_tokens"), "first_turn_processed_tokens": row["processed_tokens"]}


def table(rows: Sequence[dict[str, object]]) -> str:
    cols = ["harness", "pass", "wall_s", "tool_calls", "input_tokens", "processed_tokens", "generated_tokens",
            "cache_hit_ratio", "first_turn_input_tokens", "first_turn_processed_tokens", "note"]
    lines = ["| " + " | ".join(cols) + " |", "|" + " --- |" * len(cols)]
    for row in rows:
        lines.append("| " + " | ".join("" if row.get(c) is None else str(row.get(c)) for c in cols) + " |")
    return "\n".join(lines)


def report(rows: Sequence[dict[str, object]], meta: dict[str, str]) -> str:
    """The markdown section for one run: date, command, model, serving, then the table."""
    head = [f"## {meta['date']}", "",
            f"- command: `{meta['command']}`", f"- model: {meta['model']}",
            f"- serving: {meta['serving']}", f"- task: `{FIXTURE.relative_to(ROOT)}`, scored by its own test", ""]
    return "\n".join(head) + table(rows) + "\n"


def main(argv: Sequence[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="compare-harnesses", description=__doc__.split("\n\n")[0])
    ap.add_argument("--model", default="", help="the model to serve (Flash-Next is refused)")
    ap.add_argument("--on", default="", help="a server already running")
    ap.add_argument("--ctx", type=int, default=262144)
    ap.add_argument("--port", type=int, default=8080)
    ap.add_argument("--out", default=str(ROOT / "docs" / "experiments" / "harness-comparison.md"))
    ap.add_argument("--dry-run", action="store_true", help="print what would run and stop")
    args = ap.parse_args(argv)
    if "flash-next" in (args.model + args.on).lower():
        print("error: Flash-Next is not run in comparisons", file=sys.stderr)
        return 2
    if not args.model and not args.on:
        print("error: name --model or --on URL", file=sys.stderr)
        return 2
    plan = harnesses(args.on or "http://127.0.0.1:8080", args.ctx)
    if args.dry_run:
        for name, (_, task, _) in plan.items():
            print(f"{name}: {' '.join(task)}")
        print(f"own agent loop: {'present' if own_agent_present() else 'absent on this branch, skipped'}")
        return 0
    from ml_stack import harnessing

    def run(base_url: str, serving: str) -> int:
        rows: list[dict[str, object]] = []
        for name, (first, task, parser) in harnesses(base_url, args.ctx).items():
            if not shutil.which(name.split("-")[0]):
                rows.append({"harness": name, "note": "skipped: not installed"})
                continue
            row = measure(name, task, parser, base_url, workdir())
            row.update(probe(first, parser, base_url))
            rows.append(row)
        if not own_agent_present():
            rows.append({"harness": "ml-stack agent", "note": "skipped: no agent loop on this branch"})
        meta = {"date": datetime.date.today().isoformat(), "command": "scripts/compare-harnesses " + " ".join(argv or sys.argv[1:]),
                "model": args.model or args.on, "serving": serving}
        out = Path(args.out)
        out.parent.mkdir(parents=True, exist_ok=True)
        old = out.read_text(encoding="utf-8") if out.exists() else "# Harness comparison\n\n"
        out.write_text(old.rstrip("\n") + "\n\n" + report(rows, meta), encoding="utf-8")
        print(table(rows))
        return 0

    if args.on:
        return run(args.on.rstrip("/"), f"server already up at {args.on}")
    want = harnessing.Want(port=args.port, ctx=args.ctx)
    with harnessing.serving(args.model, want, print, "compare") as (base_url, config, _found):
        return run(base_url, f"{config.serving.slots} slot x {config.serving.slot_context} tokens, "
                             f"{config.serving.cache_type} KV")


if __name__ == "__main__":
    raise SystemExit(main())
