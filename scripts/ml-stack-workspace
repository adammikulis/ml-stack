#!/bin/sh
# Runs the Windows ml-stack-workspace.exe from a WSL shell, handing it the agent markers and the
# workspace variables through WSLENV. Install: ln -s "$PWD/scripts/ml-stack-workspace" ~/.local/bin/
set -eu

if [ -z "${WSL_DISTRO_NAME:-}" ] && ! grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
    echo "ml-stack-workspace: this wrapper is for WSL; install ml-stack here and run its own ml-stack-workspace" >&2
    exit 2
fi

exe=$(command -v ml-stack-workspace.exe || true)
if [ -z "$exe" ]; then
    profile=$(/mnt/c/Windows/System32/cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')
    exe="$(wslpath -u "$profile")/.local/bin/ml-stack-workspace.exe"
fi
if [ ! -x "$exe" ]; then
    echo "ml-stack-workspace: no ml-stack-workspace.exe on the Windows side (looked for $exe)" >&2
    exit 2
fi

ML_STACK_WSL_FORWARDED=1
export ML_STACK_WSL_FORWARDED
forward="CLAUDECODE:ML_STACK_AGENT:ML_STACK_NONINTERACTIVE:ML_STACK_TAINTED:ML_STACK_ROLE"
forward="$forward:ML_STACK_WORKSPACE_AGENT:ML_STACK_WORKSPACE_LABEL:ML_STACK_WORKSPACE_TOKEN:ML_STACK_WSL_FORWARDED"
WSLENV="${WSLENV:+$WSLENV:}$forward"
export WSLENV
exec "$exe" "$@"
