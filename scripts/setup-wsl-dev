#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
VENV="${ML_STACK_WSL_VENV:-$HOME/.venvs/ml-stack-dev}"
UV="${UV:-$(command -v uv || true)}"
if [[ -z "$UV" && -x "$HOME/.local/bin/uv" ]]; then
  UV="$HOME/.local/bin/uv"
fi
BASHRC="${BASHRC:-$HOME/.bashrc}"
CONFIG="$HOME/.config/ml-stack/wsl-dev.sh"

case "$(uname -r)" in
  *[Mm]icrosoft*) ;;
  *) printf '%s\n' 'setup-wsl-dev must run inside WSL' >&2; exit 2 ;;
esac
if [[ -z "$UV" ]]; then
  printf '%s\n' 'uv is required; install it before running setup-wsl-dev' >&2
  exit 2
fi

if [[ -x "$VENV/bin/python" ]]; then
  venv_check="$("$VENV/bin/python" -c '
import sys
from pathlib import Path

expected = Path(sys.argv[1]).resolve()
actual = Path(sys.prefix).resolve()
if sys.prefix == sys.base_prefix or actual != expected:
    print(f"not a venv rooted at {expected} (interpreter prefix: {actual})")
elif sys.version_info[:2] != (3, 12):
    print(f"uses Python {sys.version_info.major}.{sys.version_info.minor}")
else:
    print("ok")
' "$VENV")"
  if [[ "$venv_check" != ok ]]; then
    printf 'Existing environment at %s %s; remove it or set ML_STACK_WSL_VENV to a Python 3.12 venv.\n' \
      "$VENV" "$venv_check" >&2
    exit 2
  fi
else
  "$UV" venv --python 3.12 "$VENV"
fi
"$UV" pip install --python "$VENV/bin/python" "${ROOT}[wsl-dev]" \
    "ruff==0.13.3" "pyright==1.1.411" "build>=1.2" 'cuda-toolkit[nvcc]==13.0.3'
"$UV" pip install --python "$VENV/bin/python" \
    --index-url https://download.pytorch.org/whl/cu130 'torchaudio==2.11.0+cu130'
"$UV" pip install --python "$VENV/bin/python" \
    'metadrive-simulator @ git+https://github.com/metadriverse/metadrive.git@85e5dadc6c7436d324348f6e3d8f8e680c06b4db'

ffmpeg_binary="$("$VENV/bin/python" -c 'import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())')"
ln -sfn -- "$ffmpeg_binary" "$VENV/bin/ffmpeg"

mkdir -p "$(dirname -- "$CONFIG")"
tmp="$CONFIG.tmp"
{
  printf 'export ML_STACK_DEV_ROOT=%q\n' "$ROOT"
  printf 'export ML_STACK_DEV_VENV=%q\n' "$VENV"
  cat <<'ENV'
case ":$PATH:" in
    *":$ML_STACK_DEV_VENV/bin:"*) ;;
    *) export PATH="$ML_STACK_DEV_VENV/bin:$PATH" ;;
esac
export PYTHON="$ML_STACK_DEV_VENV/bin/python"
_ml_stack_cuda_home="$ML_STACK_DEV_VENV/lib/python3.12/site-packages/nvidia/cu13"
if [[ -x "$_ml_stack_cuda_home/bin/nvcc" ]]; then
    export CUDA_HOME="$_ml_stack_cuda_home"
    export CUDA_PATH="$_ml_stack_cuda_home"
    case ":$PATH:" in
        *":$_ml_stack_cuda_home/bin:"*) ;;
        *) export PATH="$_ml_stack_cuda_home/bin:$PATH" ;;
    esac
fi
unset _ml_stack_cuda_home
case ":${PYTHONPATH:-}:" in
    *":$ML_STACK_DEV_ROOT/src:"*) ;;
    *) export PYTHONPATH="$ML_STACK_DEV_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

if [[ -d /mnt/c/Users ]]; then
    _ml_stack_windows_home="$(find /mnt/c/Users -mindepth 1 -maxdepth 1 -type d -iname "${ML_STACK_WINDOWS_USER:-${USER:-}}" -print -quit 2>/dev/null || true)"
    for _ml_stack_model_root in \
        "$_ml_stack_windows_home/.ml-stack/models" \
        "$_ml_stack_windows_home/.cache/huggingface/hub" \
        "$_ml_stack_windows_home/.ollama/models" \
        "$_ml_stack_windows_home/.lmstudio/models" \
        "$_ml_stack_windows_home/.local/share/llama.cpp" \
        "$_ml_stack_windows_home/AppData/Local/llama.cpp" \
        "$_ml_stack_windows_home/jan/models" \
        "$_ml_stack_windows_home/AppData/Roaming/Jan/data/models"; do
        [[ -d "$_ml_stack_model_root" ]] || continue
        case ":${ML_STACK_MODEL_PATHS:-}:" in
            *":$_ml_stack_model_root:"*) ;;
            *) export ML_STACK_MODEL_PATHS="${ML_STACK_MODEL_PATHS:+$ML_STACK_MODEL_PATHS:}$_ml_stack_model_root" ;;
        esac
    done
    unset _ml_stack_windows_home _ml_stack_model_root
fi
ENV
} > "$tmp"
chmod 600 "$tmp"
mv -f -- "$tmp" "$CONFIG"

source_line='[ -f "$HOME/.config/ml-stack/wsl-dev.sh" ] && . "$HOME/.config/ml-stack/wsl-dev.sh"'
touch "$BASHRC"
if ! grep -Fqx "$source_line" "$BASHRC"; then
  printf '\n%s\n' "$source_line" >> "$BASHRC"
fi

printf 'Installed ml-stack with all supported extras and test dependencies in %s\n' "$VENV"
printf 'Installed CUDA-matched torchaudio and exposed the bundled ffmpeg executable in %s/bin.\n' "$VENV"
printf 'Opened shells will use source at %s and scan configured Windows model caches.\n' "$ROOT"
printf 'Run: source %s\n' "$BASHRC"
