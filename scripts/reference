#!/usr/bin/env python3
"""Print the command table, or write it back into `docs/commands.md`.

    scripts/reference            prints the table
    scripts/reference --write    replaces the table under "# The commands"
    scripts/reference --check    checks the table under "# The commands"
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "src"))

from poolhouse.cli.reference import table  # noqa: E402

SECTION = "# The commands"


def replaced(text: str, made: str) -> str:
    """``text`` with the table under `SECTION` replaced by ``made``."""
    lines = text.splitlines(keepends=True)
    start = lines.index(SECTION + "\n")
    first = next(i for i in range(start, len(lines)) if lines[i].startswith("| "))
    last = next(i for i in range(first, len(lines)) if not lines[i].startswith("| "))
    return "".join([*lines[:first], made + "\n", *lines[last:]])


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="scripts/reference", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--write", action="store_true", help="write it into docs/commands.md")
    mode.add_argument("--check", action="store_true", help="check the generated table")
    ap.add_argument("--page", default=str(REPO / "docs" / "commands.md"), help="which file")
    args = ap.parse_args(argv)
    made = table()
    if args.check:
        where = Path(args.page)
        text = where.read_text(encoding="utf-8")
        if text != replaced(text, made):
            print("Command table is stale: run scripts/reference --write", file=sys.stderr)
            return 1
        return 0
    if not args.write:
        print(made)
        return 0
    where = Path(args.page)
    where.write_text(replaced(where.read_text(encoding="utf-8"), made), encoding="utf-8")
    print(f"wrote the command table into {where}")
    return 0


if __name__ == "__main__":
    sys.stdout.reconfigure(encoding="utf-8")
    raise SystemExit(main())
