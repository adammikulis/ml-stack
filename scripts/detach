#!/usr/bin/env python3
"""Run a command fully detached, so nothing waits on it: a new session, no terminal, output to a file.

    scripts/detach LOGFILE COMMAND [ARG ...]

macOS has no `setsid`; this does the same with `os.setsid`. The command keeps running if the shell
or the tool that started it goes away, and the caller gets the process id back at once. Poll the log
with quick reads; never wait on it in the foreground.
"""
from __future__ import annotations

import os
import sys


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        sys.stderr.write(__doc__ or "")
        return 2
    log, command = argv[1], argv[2:]
    if os.fork():                                   # the caller returns at once
        return 0
    os.setsid()
    if os.fork():                                   # not a session leader: it can never get a terminal back
        os._exit(0)
    descriptor = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    quiet = os.open(os.devnull, os.O_RDONLY)
    os.dup2(quiet, 0)
    os.dup2(descriptor, 1)
    os.dup2(descriptor, 2)
    os.execvp(command[0], command)  # noqa: S606 -- running the command the person named is this tool's purpose
    return 127                                      # unreachable: exec replaced the process


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
