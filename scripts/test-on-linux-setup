#!/usr/bin/env bash
set -euo pipefail

# Same set as ci.yml's "install test dependencies", and the same reasons.
apt-get update -qq
apt-get install -y -qq bubblewrap rustc cargo >/dev/null
DEPS='pytest pytest-xdist pyyaml numpy psutil pillow networkx gguf safetensors'
# The runners have cmake; the image has not, and tests/test_serve_build.py configures a
# checkout with it. PyPI's wheel carries the binary, so it caches with the venv.
DEPS="$DEPS cmake"
EXTRAS='[test,store,hub,web,plot,privacy,guardrails,mcp,memory,fleet-onboard,pdf,fleet-update]'
SLOW=""
if printf '%s\n' "$@" | grep -qx -- '--slow'; then
  SLOW=1
  EXTRAS="${EXTRAS%]},scrape]"
fi
if printf '%s\n' "$@" | grep -qx -- '--redteam'; then
  EXTRAS="${EXTRAS%]},redteam]"
fi

mkdir -p /work
tar -C /src -cf - --exclude __pycache__ . | tar -C /work -xf -
git config --global --add safe.directory /work
mkdir -p /wheel
python -m pip wheel --quiet --no-deps --wheel-dir /wheel /work
WHEEL=(/wheel/poolhouse-*.whl)
[ "${#WHEEL[@]}" -eq 1 ]
[ -f "${WHEEL[0]}" ]
WHEEL="${WHEEL[0]}"

# Keyed by the stamp, so a concurrent run needing a different one builds a sibling
# instead of deleting the env this run may be using.
HASH="$( { echo "wheel-v1 $DEPS $EXTRAS $IMAGE"; cat /work/pyproject.toml; } | sha256sum | cut -d' ' -f1)"
ENV_DIR="/venv/$HASH/env"
STAMP="/venv/$HASH/stamp"
mkdir -p /venv
[ -n "${REBUILD:-}" ] && rm -f "$STAMP"

# flock serialises two runs that both need this stamp; the stamp is written last so a
# build another run started, and has not finished, is never read as done.
exec 9>"/venv/$HASH.lock"
flock 9
if [ ! -f "$STAMP" ]; then
  echo "test-on-linux: building the shared venv for this stamp (a few minutes; cached after this)" >&2
  rm -rf "$ENV_DIR"
  python -m venv "$ENV_DIR"
  "$ENV_DIR/bin/pip" install -q --upgrade pip build
  "$ENV_DIR/bin/pip" install -q $DEPS
  "$ENV_DIR/bin/pip" install -q torch --index-url https://download.pytorch.org/whl/cpu
  "$ENV_DIR/bin/pip" install -q "$WHEEL$EXTRAS"
  "$ENV_DIR/bin/python" -m spacy download en_core_web_sm
  # The shared environment retains dependencies; the private environment owns poolhouse.
  "$ENV_DIR/bin/pip" uninstall -y -q poolhouse
  touch "$STAMP"
fi
flock -u 9
exec 9>&-

# Sibling envs for a stamp nobody has used in days, taken non-blocking so a build another
# run is doing right now is left alone.
for dir in /venv/*/; do
  dir="${dir%/}"
  sibling="$(basename "$dir")"
  [[ "$sibling" =~ ^[0-9a-f]{64}$ ]] || continue
  [ "$sibling" = "$HASH" ] && continue
  [ -f "$dir/stamp" ] || continue
  [ -z "$(find "$dir/stamp" -mtime +4)" ] && continue
  exec 8>"/venv/$sibling.lock"
  flock -n 8 && rm -rf "$dir" "/venv/$sibling.lock"
  exec 8>&-
done

# The private environment installs this run's wheel and shares cached dependencies.
PRIV=/priv-venv
python -m venv "$PRIV"
PURELIB='import sysconfig; print(sysconfig.get_path("purelib"))'
SHARED_SITE="$("$ENV_DIR/bin/python" -c "$PURELIB")"
PRIV_SITE="$("$PRIV/bin/python" -c "$PURELIB")"
rm -rf "$SHARED_SITE/tests"
echo "$SHARED_SITE" > "$PRIV_SITE/shared-env.pth"
"$PRIV/bin/pip" install -q --no-deps "$WHEEL"

# As a person runs it, and as CI runs it. Root ignores a 0o500 directory, so the tests
# that check a refusal on an unwritable path see no refusal.
groupadd --non-unique --gid "$HOST_GID" tester
useradd --uid "$HOST_UID" --gid "$HOST_GID" --create-home tester
if [ -n "$SLOW" ]; then
  export PLAYWRIGHT_BROWSERS_PATH=/home/tester/.cache/ms-playwright
  "$PRIV/bin/python" -m playwright install --with-deps chromium
fi
chown -R "$HOST_UID:$HOST_GID" /work /home/tester "$PRIV"
export HOME=/home/tester
# A fake server the tests write into a temp directory runs `python3` off PATH; the
# private venv is the one with pytest and the rest of the deps, ahead of the shared env's
# own bin, which still needs to be reachable for a dependency's console script (cmake).
export PATH="$PRIV/bin:$ENV_DIR/bin:$PATH"
printf 'export PATH=%q\n' "$PATH" > /test-env
printf 'export HOME=/home/tester\n' >> /test-env
if [ -n "$SLOW" ]; then
  printf 'export PLAYWRIGHT_BROWSERS_PATH=%q\n' "$PLAYWRIGHT_BROWSERS_PATH" >> /test-env
fi
