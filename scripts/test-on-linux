#!/usr/bin/env bash
# Run the suite in a Linux container against this worktree.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="3.13"
# python:$PYTHON rather than -slim: a hundred tests shell out to git, which -slim has not.
IMAGE="${POOLHOUSE_LINUX_IMAGE:-python:$PYTHON}"
PLATFORM="${POOLHOUSE_LINUX_PLATFORM:-}"
VOLUME="${POOLHOUSE_LINUX_VOLUME:-poolhouse-linux-suite}"

usage() {
  cat <<'HELP'
scripts/test-on-linux [--single] [--rebuild] [--platform P] [pytest args...]

Runs explicit reviewed selectors inside an isolated Linux container, with test extras,
and prints what pytest prints. Arguments after the script's own flags go to pytest:

    scripts/test-on-linux tests/test_layers.py -q
    scripts/test-on-linux --single tests/test_cli_reference.py

Selectors and fixture resources must be admitted by the maintained test supervisor.

  --single        run in one process (-n 0), so an order-dependent test is not hidden
                  by xdist scattering the file across workers
  --rebuild       discard the cached venv for this stamp and install it again
  --platform P    docker platform, e.g. linux/amd64 to match the CI runners under
                  emulation. The default is this machine's own architecture; both
                  Linuxes catch a pass that is only macOS's, and an emulated run is
                  several times slower.

The supervisor stages tracked source files into an immutable container image, so
the tests that read a real repository have one and nothing the run writes lands in
yours. The dependencies live in a docker volume, keyed by a hash of pyproject.toml and
the installed set, and are rebuilt only when that hash changes. Each run then makes its
own throwaway venv inside the container for an immutable wheel of this checkout, so
two runs sharing the volume never see each other's install in progress.

Docker credentials: on macOS the desktop credential helper can hang an image pull
(`error getting credentials - err: signal: terminated`). This script passes every
docker command a --config directory holding no credsStore, so the helper is never
consulted; the image is public and needs no login.
HELP
}

SINGLE=""
REBUILD=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --single) SINGLE=1; shift ;;
    --rebuild) REBUILD=1; shift ;;
    --platform) PLATFORM="$2"; shift 2 ;;
    *) break ;;
  esac
done

PYTEST_ARGS=("$@")
if [ ${#PYTEST_ARGS[@]} -eq 0 ]; then
  echo "scripts/test-on-linux: explicit reviewed selectors are required" >&2
  exit 2
fi
export PYTHONPATH="$REPO/src:$REPO/scripts"
WANT=0
[ -n "$SINGLE" ] && WANT=1
# The scheduler owns the process count; explicit pytest values are ceilings.
CLEAN_ARGS=()
while [ ${#PYTEST_ARGS[@]} -gt 0 ]; do
  ARG="${PYTEST_ARGS[0]}"
  PYTEST_ARGS=("${PYTEST_ARGS[@]:1}")
  case "$ARG" in
    -n|--numprocesses)
      WANT="${PYTEST_ARGS[0]}"; PYTEST_ARGS=("${PYTEST_ARGS[@]:1}") ;;
    -n[0-9]*|--numprocesses=*) WANT="${ARG#*=}"; WANT="${WANT#-n}" ;;
    *) CLEAN_ARGS+=("$ARG") ;;
  esac
done
case "$WANT" in
  auto) WANT=0 ;;
  0) [ -z "$SINGLE" ] || WANT=1 ;;
esac
[ -n "$SINGLE" ] && WANT=1
BROKER="${DEV_TEST_SLOTS_DIR:-$HOME/.cache/dev-test-slots}"
mkdir -p "$BROKER"
BROKER="$(cd "$BROKER" && pwd)"
export DEV_TEST_SLOTS_DIR="$BROKER"
export POOLHOUSE_LINUX_IMAGE="$IMAGE" POOLHOUSE_LINUX_VOLUME="$VOLUME" POOLHOUSE_LINUX_PLATFORM="$PLATFORM"
export POOLHOUSE_LINUX_SINGLE="$SINGLE" POOLHOUSE_LINUX_REBUILD="$REBUILD"
python3 "$REPO/scripts/testslots.py" pytest --container --want "$WANT" --min 1 --label "poolhouse: Linux tests" -- \
  "$(python3 -c 'import sys; print(sys.executable)')" -m pytest "${CLEAN_ARGS[@]}"
