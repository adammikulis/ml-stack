#!/usr/bin/env python3
"""A SubagentStop hook: records the subagent's model from its transcript and announces that it finished."""

from __future__ import annotations

import json
from pathlib import Path

import workspace_hook


def label_of(event: dict) -> str:
    return f"{event.get('agent_type') or 'subagent'}-{str(event.get('agent_id') or '')[:6]}".strip("-").lower()


def transcript_model(path: str) -> str:
    """The model id on the last assistant line of a transcript, or an empty string."""
    found = ""
    try:
        with open(path) as lines:
            for line in lines:
                try:
                    model = json.loads(line).get("message", {}).get("model", "")
                except (ValueError, AttributeError):
                    continue
                if isinstance(model, str) and model.startswith("claude-"):
                    found = model
    except OSError:
        return ""
    return found


def main() -> int:
    event = workspace_hook.event("SubagentStop")
    if event is None:
        return 0
    environment = workspace_hook.session_environment(event, "SubagentStop")
    if environment is None:
        return 0
    label = label_of(event)
    path = event.get("agent_transcript_path") or ""
    model = transcript_model(str(path)) if path else ""
    if model:
        workspace_hook.run(["ml-stack-workspace", "hello-model", label, model, "--agent", "claude-code"],
                           "SubagentStop", environment=environment)
    last = " ".join(str(event.get("last_assistant_message") or "finished").split())[:150]
    workspace_hook.run(["ml-stack-workspace", "announce", "done", f"{label}: {last}",
                        "--agent", "claude-code", "--label", label], "SubagentStop", environment=environment)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
