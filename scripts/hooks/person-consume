#!/usr/bin/env python3
"""Consumes the live person authorization for KIND in this session: exit 0 and print its id, or exit 1 and say why.

    person-consume push-dev REMOTE   the guard derives the target from the checkout it runs in
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))
from ml_stack.workspace import person_auth, person_targets


def main(argv: list[str]) -> int:
    """Return 0 when an authorization was consumed."""
    if len(argv) != 3 or argv[1] != "push-dev":
        print(__doc__, file=sys.stderr)
        return 2
    target = person_targets.push_dev_target(os.getcwd(), argv[2])
    identity = person_auth.Identity(os.environ.get("ML_STACK_SESSION_ID", ""), os.environ.get("ML_STACK_AGENT_LABEL", ""))
    try:
        print(person_auth.consume("push-dev", target, identity))
    except person_auth.NotAuthorized as error:
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
