#!/bin/sh
# After a commit in a linked worktree, tell the owner and the coordinator when the tree is too far ahead of the
# development branch. Costs three quick git calls and no Python unless the threshold is crossed, and then Python
# runs at most once per ML_STACK_TREES_REPEAT_MIN (30) minutes per repository. The primary checkout (a person
# using plain git) is never touched; any failure is silent and never blocks the commit.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
here=$(cd "$(dirname "$self")" && pwd)
common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
[ "$(git rev-parse --git-dir 2>/dev/null)" = "$common" ] && exit 0
dev=$(git worktree list --porcelain 2>/dev/null | awk '/^branch /{print substr($2, 12); exit}')
if [ -n "$dev" ]; then
    ahead=$(git rev-list --count "$dev..HEAD" 2>/dev/null || echo 0)
    [ "$ahead" -lt "${ML_STACK_TREES_MAX_AHEAD:-10}" ] 2>/dev/null && exit 0
fi
stamp="$common/ml-stack-trees.stamp"
[ -n "$(find "$stamp" -mmin -"${ML_STACK_TREES_REPEAT_MIN:-30}" 2>/dev/null)" ] && exit 0
: > "$stamp" 2>/dev/null
"${PYTHON:-python3}" "$here/tree_watch.py" post-commit || true
exit 0
