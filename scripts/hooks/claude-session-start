#!/usr/bin/env python3
"""A SessionStart hook: records the session's model with the workspace as a claimed model."""

from __future__ import annotations

import json
import os
import subprocess
import sys


def main() -> int:
    event = json.load(sys.stdin)
    model = event.get("model") or os.environ.get("ANTHROPIC_MODEL", "")
    if isinstance(model, dict):
        model = model.get("id", "")
    if not model:
        return 0
    subprocess.run(["ml-stack-workspace", "whoami", "--agent", "claude-code", "--model", model,
                    "--harness", "claude-code"], capture_output=True, check=False, timeout=30)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
