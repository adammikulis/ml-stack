#!/usr/bin/env python3
"""A SessionStart hook: joins the ml-stack workspace as claude-code without a code on a trusted
machine, and says so in the session's context only when it made a new identity."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

NAME = "claude-code"
WRAPPER = Path(__file__).resolve().parent.parent / "ml-stack-workspace"
TIMEOUT_S = 20


def command() -> list[str]:
    """The workspace command: the installed one, else the WSL wrapper under WSL, else none."""
    found = shutil.which("ml-stack-workspace")
    if found:
        return [found]
    return [str(WRAPPER)] if os.environ.get("WSL_DISTRO_NAME") and WRAPPER.exists() else []


def model(event: dict) -> str:
    """The session's model id from the hook input, else an empty string."""
    given = event.get("model")
    if isinstance(given, dict):
        given = given.get("id", "")
    return given if isinstance(given, str) else ""


def main() -> int:
    try:
        event = json.load(sys.stdin)
    except ValueError:
        event = {}
    run = command()
    if not run:
        return 0
    event = event if isinstance(event, dict) else {}
    chosen = model(event)
    argv = [*run, "join", "--name", NAME, "--harness", "claude-code", *(["--model", chosen] if chosen else [])]
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=TIMEOUT_S, check=False,
                              cwd=event.get("cwd") or None)
    except (OSError, subprocess.TimeoutExpired):
        return 0
    line = done.stdout.strip()
    if done.returncode == 0 and line.startswith("joined as "):
        name = line.removeprefix("joined as ").strip()
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": f"You joined the ml-stack workspace as {name}; add --agent {name} "
                                 f"to each ml-stack-workspace command."}}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
