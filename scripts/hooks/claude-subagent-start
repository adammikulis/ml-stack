#!/usr/bin/env python3
"""A SubagentStart hook: puts the worktree rule and the development branch in a subagent's context."""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import rules_loader
import workspace_hook


ALIASES = {"sonnet": "claude-sonnet-5-5", "opus": "claude-opus-5-5", "haiku": "claude-haiku-4-5-20251001",
           "fable": "claude-fable-5-1"}


def label_of(event: dict) -> str:
    return f"{event.get('agent_type') or 'subagent'}-{str(event.get('agent_id') or '')[:6]}".strip("-").lower()


def definition_model(event: dict) -> str:
    """The model id an agent definition's `model:` names, or an empty string when it inherits."""
    kind = str(event.get("agent_type") or "")
    root = Path(event.get("cwd") or ".")
    for path in (root / ".claude" / "agents" / f"{kind}.md", Path.home() / ".claude" / "agents" / f"{kind}.md"):
        try:
            head = path.read_text().split("---")[1]
        except (OSError, IndexError):
            continue
        for line in head.splitlines():
            key, _, value = line.partition(":")
            if key.strip() == "model":
                value = value.strip()
                return ALIASES.get(value, value if value.startswith("claude-") else "")
    return ""


def workspace_brief(event: dict) -> str:
    label = label_of(event)
    environment = workspace_hook.session_environment(event, "SubagentStart")
    if environment is None:
        return ""
    model = definition_model(event)
    if model:
        workspace_hook.run(["ml-stack-workspace", "hello-model", label, model, "--agent", "claude-code"],
                           "SubagentStart", environment=environment)
    purpose = " ".join(str(event.get("description") or event.get("agent_type") or "subagent").split())[:150]
    joined = workspace_hook.run(["ml-stack-workspace", "announce", "joined", f"{label}: {purpose}",
                                 "--agent", "claude-code", "--label", label], "SubagentStart", environment=environment)
    done = workspace_hook.run(["ml-stack-workspace", "brief", label, "--agent", "claude-code", "--registered"],
                              "SubagentStart", environment=environment)
    return done.stdout.strip() if done else ""


def main() -> int:
    event = workspace_hook.event("SubagentStart")
    if event is None:
        return 0
    rules = rules_loader.load()
    try:
        found = rules.checkouts(event.get("cwd") or ".") if rules else None
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError) as error:
        workspace_hook.warning("SubagentStart", error)
        found = None
    parts = [workspace_brief(event)]
    if found:
        parts.append(checkout_rule(found[1]))
    text = "\n\n".join(p for p in parts if p)
    if not text:
        return 0
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SubagentStart",
                                             "additionalContext": text}}))
    return 0


def checkout_rule(primary: Path) -> str:
    done = workspace_hook.run(["git", "-C", str(primary), "branch", "--show-current"], "SubagentStart")
    dev = done.stdout.strip() if done else "unknown"
    return (f"Checkout rule: the primary checkout {primary} is on the development branch {dev}. "
            "Use it when that is the best way to complete the task; concurrent writers, experiments "
            "and conflicts require separate sibling worktrees and branches. Acquire authenticated "
            "claims before mutation, preserve unrelated work, and stage files by name. "
            "Independent review and affected tests are required. Never use editable installs "
            "or commit or push main without the owner's explicit instruction.")


if __name__ == "__main__":
    raise SystemExit(main())
