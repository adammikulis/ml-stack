#!/usr/bin/env python3
"""A PreToolUse hook on Bash that refuses shell commands that should be poolhouse commands.

Claude Code runs this before every Bash call. Exit 2 blocks the command and hands the
message back.
Set POOLHOUSE_GUARD=off to disable the soft rules for a session; the hard rules (pushes of main, tags,
force and deletions, minting identities, the person record) stay in force.

Wire it in as a PreToolUse hook on Bash in a project's `.claude/settings.json`:

    {"hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
        {"type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/claude-bash-guard"}]}]}}

A project that wants its own wiring writes a thin `sh` wrapper that execs this file with
stdin passed through, and exits 0 with a note when this copy is missing -- a missing guard
must not block every Bash call.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import rules_loader

# The start of a command, past any NAME=value the caller put in front of it.
RUN = r"(^|[;&|(]\s*|\bthen\s+|\bdo\s+|\bexec\s+)(\w+=\S*\s+)*"

# The start of a git push: a command start, a quote (sh -c "..."), or an env / sudo / command prefix.
PUSHER = (r"(^|[;&|(]\s*|\bthen\s+|\bdo\s+|\bexec\s+|[\"'`]\s*|\bsudo\s+|\bcommand\s+"
          r"|\benv\s+(-\S+\s+(\w+\s+)?|\w+=\S*\s+)*)(\w+=\S*\s+)*")
GIT_PUSH = r"git\s+(-[Cc]\s+\S+\s+|--\S+\s+)*push\b"

PUSH_MAIN = PUSHER + GIT_PUSH + r"[^;&|\n]*\bmain\b"
PUSH_FLAGS = (PUSHER + GIT_PUSH + r"[^;&|\n]*(--all\b|--mirror\b|--tags\b|--delete\b"
              r"|--force|\s-f\b|\s-d\b)")
MINT = RUN + r"(\S*/)?poolhouse-workspace\s+(-\S+\s+)*(mint|delegate)\b"
PERSON_STORE = (r"\.poolhouse/person\b|person/statements\.log|\bCLAUDE_CONFIG_DIR=|"
                r"(import|from)\s+poolhouse\.workspace(\.|\s+import\s+[^;\n]*\b)person_\w+|"
                r"-m\s+poolhouse\.workspace\.person_|"
                + RUN + r"(\S*python\S*\s+|(ba)?sh\s+)?(\S*/)?(claude-user-prompt|person-consume(?!\s+propose\b))")
HERE = Path(__file__).resolve().parent

# (what it matches, what to do instead). Ordered: the first match wins.
REFUSE = [
    (RUN + r"git\s+add\s+(-A\b|--all\b|\.(\s|$)|-u\b|--update\b)|"
     + RUN + r"git\s+commit\s+(-a\b|-am\b|--all\b)",
     "Do not stage everything. `git add -A` (and `add .`, `add -u`, `commit -a`) sweeps in "
     "whatever another agent is halfway through writing -- it committed a failing test once, "
     "under somebody else's commit message. Name the files you mean: `git add path/one.py "
     "path/two.py`."),
    (RUN + r"git\s+stash(\s*($|[;&|])|\s+(pop|save|clear)\b|\s+(-u|--include-untracked)\b|"
     r"\s+push(?![^;&|\n]*\s-m\b))",
     "Do not use a bare `git stash`, `stash pop` or an untagged `stash push`. The stash stack is shared by "
     "every worktree, so a pop can restore another agent's work over yours (and a stash with no tag cannot "
     "be found again). Set work aside with a WIP commit instead. If you must stash: `git stash push -u -m "
     "<unique-tag>`, find your entry's SHA with `git stash list --format='%H %gs'`, restore it with "
     "`git stash apply <sha>`, then drop that one entry by its re-found `stash@{n}`."),
    (r"until\s*!\s*pgrep|while\s+pgrep|until\s+pgrep",
     "Do not hand-write a waiter. `pgrep -f` matches the waiting shell's own command line, "
     "so the loop never exits -- two of them spun for an afternoon and the work queued "
     "behind them never ran. `poolhouse-bench run|sweep|drafts` now takes a lock and waits "
     "for whoever is measuring (`poolhouse.lock.only_one`); just start it."),
    (RUN + r"nohup\b",
     "Do not `nohup ... &`. Use the Bash tool's run_in_background, which reports the exit "
     "code and keeps the output, or `poolhouse-bench sweep --serve`, which puts one model up "
     "at a time on purpose. Backgrounded jobs have died silently here before."),
    (RUN + r"(sudo\s+|env\s+|time\s+|nice\s+|nohup\s+)*(\S*/)?llama-server(\s|$)",
     "Do not start llama-server by hand. `poolhouse-serve up MODEL --context 256k` asks the "
     "broker for a lease: it checks the memory, queues behind other leases, picks the port "
     "(a port another process holds is never fought over), applies the measured profile and "
     "keeps the server up until `poolhouse-serve down MODEL`. A server started by hand "
     "skips all of that and the next lease refuses."),
    (r"\bPOOLHOUSE_BROKER_LOCAL=",
     "POOLHOUSE_BROKER_LOCAL runs a private broker inside the process, with no queue and no "
     "view of the machine's other servers; it is for the tests. Ask the machine's broker: "
     "`poolhouse-serve up MODEL`."),
    (RUN + r"poolhouse-serve\s+up\b[^;&|\n]*\s(--direct|--no-broker|--no-lease|--anyway|"
     r"--unmanaged|--no-queue)\b",
     "`poolhouse-serve up` is a lease and no flag skips the broker. Drop the flag: "
     "`poolhouse-serve up MODEL --context N` (add --no-wait to return while it is queued)."),
    (r"\bfind\b[^|;]*\.gguf|\bls\b[^|;]*\*\.gguf",
     "Do not hunt for GGUFs with find/ls. `poolhouse-models find <words>` searches the Hub "
     "and `poolhouse-models files <repo>` lists what is already on this machine -- a Hub "
     "cache is symlinks into blobs/, so `ls -l` reports 79 bytes for a 46G shard and reading "
     "that as 'not downloaded' nearly re-fetched 87G."),
    (r"\bhuggingface-cli\s+download\b|\bhf\s+download\b",
     "Do not download by hand. `poolhouse-serve up hf:owner/repo/file` fetches on first use, "
     "into the same cache, and `poolhouse-models files <repo>` says what is already here."),
    (r"\bcurl\b[^|;]*(127\.0\.0\.1|localhost)[^|;]*(/v1/|/props|/slots|/completion)",
     "Do not probe the model with curl. `poolhouse.client.Client` carries the sampling and "
     "the budgets, and `poolhouse-bench` records what it measured. Ad-hoc curl probes have "
     "produced numbers that went nowhere and an 80-token budget that returned empty text."),
    (r"\bpkill\b[^|;]*llama|\bkillall\b[^|;]*llama",
     "Do not pkill llama-server. `poolhouse-serve down --port N` releases the lease too; "
     "killing the process leaves the lease behind and the next `up` refuses."),
    (PUSH_FLAGS,
     "An agent pushes one branch by name: `git push origin <branch>`. Every branch at "
     "once, a tag, a deletion and a forced push stay the owner's, and no opener opens "
     "them."),
    (PUSH_MAIN,
     "An agent pushes the development branch by name: `git push origin <development branch>` "
     "after a merge lands on it. A push to `main` publishes: release-please reads the subjects "
     "there, so it moves the release pull request and releases every commit on the branch at "
     "once. It needs the person's approval of that one commit: run "
     "`scripts/hooks/person-consume propose`, ask its question with AskUserQuestion word for "
     "word, and push main only after the person selects the approval."),
    (MINT,
     "An agent does not create identities. A person at a terminal mints a token; a joined agent "
     "starts a new agent with `poolhouse-workspace invite`."),
    (PERSON_STORE,
     "The person record is written only by the harness hooks when the person types. An agent "
     "does not read its key, open its log or import its writers; `poolhouse-workspace "
     "attestations` shows what the hooks recorded."),
    (r"(^|[;&|]\s*|\benv\s+)SKIP_NAME_CHECK=1",
     "SKIP_NAME_CHECK is a person's to set, not an agent's. The hook is the last thing "
     "between a real community and a public repository. If it flagged an invented name, add "
     "it to known-fixtures.txt; if it flagged a real one, the fix is to invent one."),
]


def without_heredocs(command: str) -> str:
    """Drop heredoc bodies, which are data being written rather than commands being run.

    This guard blocked its own installation twice: the command wrote documentation *about*
    a forbidden shell into a file through a heredoc, and the pattern matched the prose. A
    rule that fires on text being written is a rule people learn to switch off -- and it
    cannot be repaired through the tool it guards, so it must not need repairing often.
    """
    kept, lines, i = [], command.split("\n"), 0
    while i < len(lines):
        kept.append(lines[i])
        opened = re.search(r"<<-?\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?", lines[i])
        if opened:
            end = opened.group(1)
            i += 1
            while i < len(lines) and lines[i].strip() != end:
                i += 1
        i += 1
    return "\n".join(kept)


SEARCHERS = r"grep|egrep|fgrep|rg|ag|ack|awk|sed|comm|diff"


def without_search_patterns(command: str) -> str:
    """Drop the quoted arguments of a search command, which are text being looked for."""
    def strip(match: re.Match) -> str:
        head = match.group(0)
        return re.sub(r"'[^']*'|\"[^\"]*\"", "''", head)
    return re.sub(rf"\b({SEARCHERS})\b[^|;&\n]*", strip, command)


HARD = (PUSH_FLAGS, PUSH_MAIN, MINT, PERSON_STORE)
"""Patterns that stay in force when POOLHOUSE_GUARD=off is set: this guard only ever runs on an agent's call."""

MESSAGE = re.compile(r"(-m|--message)(\s+|=)('[^']*'|\"[^\"]*\")")


WORKSPACE = RUN + r"(\S*/)?poolhouse-workspace\b"


def subagent_without_its_name(event: dict, command: str) -> str:
    """The board name a subagent must pass as `--agent` when its workspace command omits it, else an empty string.

    A subagent's shell inherits its lead's environment, so a command without `--agent` would act as
    the lead; the SubagentStart hook gave the subagent its own name and token."""
    agent = str(event.get("agent_id") or "")
    if not agent or not re.search(WORKSPACE, command, re.M) or re.search(r"--agent[ =]", command):
        return ""
    import workspace_hook
    return workspace_hook.agent_name(agent)


def release_approved(cwd: str) -> bool:
    """Whether this session holds a live release-main approval for the repository at ``cwd``."""
    try:
        done = subprocess.run([sys.executable, str(HERE / "person-consume"), "peek"], cwd=cwd or None,
                              capture_output=True, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return done.returncode == 0


def main() -> int:
    switched = rules_loader.guard_off()
    try:
        event = json.load(sys.stdin)
    except Exception:
        return 0
    if event.get("tool_name") != "Bash":
        return 0
    command = without_heredocs((event.get("tool_input") or {}).get("command") or "")
    rules = None if switched else rules_loader.load()
    why = rules.bash_refusal(command, event.get("cwd") or "") if rules else ""
    if why:
        print(f"blocked: {why}\n\n(poolhouse scripts/hooks/claude-bash-guard. Set "
              f"POOLHOUSE_GUARD=off for a person's own session.)", file=sys.stderr)
        return 2
    named = "" if switched else subagent_without_its_name(event, command)
    if named:
        print(f"blocked: you are the subagent {named}. Run workspace commands as yourself with "
              f"`--agent {named}`; without it the command acts as the session that started you.\n\n"
              f"(poolhouse scripts/hooks/claude-bash-guard. Set POOLHOUSE_GUARD=off for a person's own session.)",
              file=sys.stderr)
        return 2
    command = MESSAGE.sub(r"\1 ''", without_search_patterns(command))
    for pattern, instead in REFUSE:
        if switched and pattern not in HARD:
            continue
        if re.search(pattern, command, re.M):
            if pattern is PUSH_MAIN and not re.search(PUSH_FLAGS, command) and release_approved(event.get("cwd") or ""):
                continue
            tail = ("No switch opens this rule." if pattern in HARD else
                    "If this is genuinely the right command, say so and a person can run it, "
                    "or set POOLHOUSE_GUARD=off.")
            print(f"blocked: {instead}\n\n(poolhouse scripts/hooks/claude-bash-guard. {tail})",
                  file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
