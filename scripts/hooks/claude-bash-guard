#!/usr/bin/env python3
"""A PreToolUse hook on Bash that refuses shell commands that should be ml-stack commands.

Claude Code runs this before every Bash call. Exit 2 blocks the command and hands the
message back.
Set MLSTACK_GUARD=off to disable it for a session.

Wire it in as a PreToolUse hook on Bash in a project's `.claude/settings.json`:

    {"hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
        {"type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/claude-bash-guard"}]}]}}

A project that wants its own wiring writes a thin `sh` wrapper that execs this file with
stdin passed through, and exits 0 with a note when this copy is missing -- a missing guard
must not block every Bash call.
"""

import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import rules_loader

# The start of a command, past any NAME=value the caller put in front of it.
RUN = r"(^|[;&|(]\s*|\bthen\s+|\bdo\s+|\bexec\s+)(\w+=\S*\s+)*"

PUSH_MAIN = RUN + r"git\s+push\b[^;&|\n]*\bmain\b"

# Read off the command rather than the environment: the guard is told what to allow by the
# command it is asked about.
PUSH_MAIN_OPENED = r"\bML_STACK_PUSH_MAIN=yes\b"


PUSH_FLAGS = (RUN + r"git\s+push\b[^;&|\n]*(--all\b|--mirror\b|--tags\b|--delete\b"
              r"|--force|\s-f\b|\s-d\b)")
MINT = RUN + r"(\S*/)?ml-stack-workspace\s+(-\S+\s+)*(mint|delegate)\b"
PERSON_STORE = (r"\.ml-stack/person\b|person/statements\.log|"
                r"(import|from)\s+ml_stack\.workspace(\.person_record\b|\s+import\s+[^;\n]*\bperson_record\b)")

# (what it matches, what to do instead). Ordered: the first match wins.
REFUSE = [
    (RUN + r"git\s+add\s+(-A\b|--all\b|\.(\s|$)|-u\b|--update\b)|"
     + RUN + r"git\s+commit\s+(-a\b|-am\b|--all\b)",
     "Do not stage everything. `git add -A` (and `add .`, `add -u`, `commit -a`) sweeps in "
     "whatever another agent is halfway through writing -- it committed a failing test once, "
     "under somebody else's commit message. Name the files you mean: `git add path/one.py "
     "path/two.py`."),
    (r"until\s*!\s*pgrep|while\s+pgrep|until\s+pgrep",
     "Do not hand-write a waiter. `pgrep -f` matches the waiting shell's own command line, "
     "so the loop never exits -- two of them spun for an afternoon and the work queued "
     "behind them never ran. `ml-stack-bench run|sweep|drafts` now takes a lock and waits "
     "for whoever is measuring (`ml_stack.lock.only_one`); just start it."),
    (RUN + r"nohup\b",
     "Do not `nohup ... &`. Use the Bash tool's run_in_background, which reports the exit "
     "code and keeps the output, or `ml-stack-bench sweep --serve`, which puts one model up "
     "at a time on purpose. Backgrounded jobs have died silently here before."),
    (RUN + r"(sudo\s+|env\s+|time\s+|nice\s+|nohup\s+)*(\S*/)?llama-server(\s|$)",
     "Do not start llama-server by hand. `ml-stack-serve up MODEL --context 256k` asks the "
     "broker for a lease: it checks the memory, queues behind other leases, picks the port "
     "(a port another process holds is never fought over), applies the measured profile and "
     "keeps the server up until `ml-stack-serve down MODEL`. A server started by hand "
     "skips all of that and the next lease refuses."),
    (r"\bML_STACK_BROKER_LOCAL=",
     "ML_STACK_BROKER_LOCAL runs a private broker inside the process, with no queue and no "
     "view of the machine's other servers; it is for the tests. Ask the machine's broker: "
     "`ml-stack-serve up MODEL`."),
    (RUN + r"ml-stack-serve\s+up\b[^;&|\n]*\s(--direct|--no-broker|--no-lease|--anyway|"
     r"--unmanaged|--no-queue)\b",
     "`ml-stack-serve up` is a lease and no flag skips the broker. Drop the flag: "
     "`ml-stack-serve up MODEL --context N` (add --no-wait to return while it is queued)."),
    (r"\bfind\b[^|;]*\.gguf|\bls\b[^|;]*\*\.gguf",
     "Do not hunt for GGUFs with find/ls. `ml-stack-models find <words>` searches the Hub "
     "and `ml-stack-models files <repo>` lists what is already on this machine -- a Hub "
     "cache is symlinks into blobs/, so `ls -l` reports 79 bytes for a 46G shard and reading "
     "that as 'not downloaded' nearly re-fetched 87G."),
    (r"\bhuggingface-cli\s+download\b|\bhf\s+download\b",
     "Do not download by hand. `ml-stack-serve up hf:owner/repo/file` fetches on first use, "
     "into the same cache, and `ml-stack-models files <repo>` says what is already here."),
    (r"\bcurl\b[^|;]*(127\.0\.0\.1|localhost)[^|;]*(/v1/|/props|/slots|/completion)",
     "Do not probe the model with curl. `ml_stack.client.Client` carries the sampling and "
     "the budgets, and `ml-stack-bench` records what it measured. Ad-hoc curl probes have "
     "produced numbers that went nowhere and an 80-token budget that returned empty text."),
    (r"\bpkill\b[^|;]*llama|\bkillall\b[^|;]*llama",
     "Do not pkill llama-server. `ml-stack-serve down --port N` releases the lease too; "
     "killing the process leaves the lease behind and the next `up` refuses."),
    (PUSH_FLAGS,
     "An agent pushes one branch by name: `git push origin <branch>`. Every branch at "
     "once, a tag, a deletion and a forced push stay the owner's, and no opener opens "
     "them."),
    (PUSH_MAIN,
     "An agent pushes the development branch by name and nothing else: `git push origin "
     "<development branch>` after a merge lands on it. A push to `main` publishes: "
     "release-please reads the subjects there, so it moves the release pull request and "
     "releases every commit on the branch at once.\n\n"
     "When the owner has asked for that push, the ask is written on the command itself:  "
     "ML_STACK_PUSH_MAIN=yes git push origin main"),
    (MINT,
     "An agent does not create identities. A person at a terminal mints a token; a joined agent "
     "starts a new agent with `ml-stack-workspace invite`."),
    (PERSON_STORE,
     "The person record is written only by the harness hooks when the person types. An agent "
     "does not read its key, open its log or import its writers; `ml-stack-workspace "
     "attestations` shows what the hooks recorded."),
    (r"(^|[;&|]\s*|\benv\s+)SKIP_NAME_CHECK=1",
     "SKIP_NAME_CHECK is a person's to set, not an agent's. The hook is the last thing "
     "between a real community and a public repository. If it flagged an invented name, add "
     "it to known-fixtures.txt; if it flagged a real one, the fix is to invent one."),
]


def without_heredocs(command: str) -> str:
    """Drop heredoc bodies, which are data being written rather than commands being run.

    This guard blocked its own installation twice: the command wrote documentation *about*
    a forbidden shell into a file through a heredoc, and the pattern matched the prose. A
    rule that fires on text being written is a rule people learn to switch off -- and it
    cannot be repaired through the tool it guards, so it must not need repairing often.
    """
    kept, lines, i = [], command.split("\n"), 0
    while i < len(lines):
        kept.append(lines[i])
        opened = re.search(r"<<-?\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?", lines[i])
        if opened:
            end = opened.group(1)
            i += 1
            while i < len(lines) and lines[i].strip() != end:
                i += 1
        i += 1
    return "\n".join(kept)


SEARCHERS = r"grep|egrep|fgrep|rg|ag|ack|awk|sed|comm|diff"


def without_search_patterns(command: str) -> str:
    """Drop the quoted arguments of a search command, which are text being looked for."""
    def strip(match: re.Match) -> str:
        head = match.group(0)
        return re.sub(r"'[^']*'|\"[^\"]*\"", "''", head)
    return re.sub(rf"\b({SEARCHERS})\b[^|;&\n]*", strip, command)


HARD = (PUSH_FLAGS, PUSH_MAIN, MINT, PERSON_STORE)
"""Patterns that stay in force when MLSTACK_GUARD=off is set under an agent."""


def main() -> int:
    switched = rules_loader.guard_off()
    if switched == "off":
        return 0
    try:
        event = json.load(sys.stdin)
    except Exception:
        return 0
    if event.get("tool_name") != "Bash":
        return 0
    command = without_heredocs((event.get("tool_input") or {}).get("command") or "")
    rules = None if switched else rules_loader.load()
    why = rules.bash_refusal(command, event.get("cwd") or "") if rules else ""
    if why:
        print(f"blocked: {why}\n\n(ml-stack scripts/hooks/claude-bash-guard. Set "
              f"MLSTACK_GUARD=off for a person's own session.)", file=sys.stderr)
        return 2
    command = without_search_patterns(command)
    for pattern, instead in REFUSE:
        if switched and pattern not in HARD:
            continue
        if re.search(pattern, command, re.M):
            if pattern is PUSH_MAIN and re.search(PUSH_MAIN_OPENED, command):
                continue
            tail = ("No switch opens this rule." if pattern in HARD else
                    "If this is genuinely the right command, say so and a person can run it, "
                    "or set MLSTACK_GUARD=off.")
            print(f"blocked: {instead}\n\n(ml-stack scripts/hooks/claude-bash-guard. {tail})",
                  file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
