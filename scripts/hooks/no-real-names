#!/bin/sh
# Refuse any commit that carries a person's name, handle or contact details.
#
# Nothing in this repository may name a person. Test data is invented, always.
#
# Two detectors, because each misses what the other catches:
#   - Presidio's recogniser reads every staged file and refuses a person it finds, including
#     one it has never seen before. Where the recogniser has no feel for a name, a shape rule
#     catches anything that looks like one inside a quoted string.
#   - An exact list read from a local database catches lowercase handles that a recogniser
#     does not read as names. Neither list is written down: the names are read at commit time.
#
# Configuration, all by environment variable so another repo can wrap this file:
#   NAMES_GRAPH     a graph JSON; its person and org entries and its message senders
#                   are refused (default: none)
#   NAMES_SCRAPE    a JSONL file whose "sender" fields are refused (default: none)
#   NAMES_FIXTURES  the allow-list of invented names (default: tests/known-fixtures.txt,
#                   relative to the repo root; an absolute path is used as given)
#   PYTHON          the interpreter to run (default: python3)
#
# Install:  scripts/install-hooks.sh
#           pip install -e '.[privacy]' && python -m spacy download en_core_web_sm
# Override: SKIP_NAME_CHECK=1 git commit ...   only after reading what it flagged.

[ -n "$SKIP_NAME_CHECK" ] && exit 0

PY="${PYTHON:-python3}"

"$PY" - <<'PY' || exit 1
import json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
GRAPH = os.environ.get("NAMES_GRAPH", "")
SCRAPE = os.environ.get("NAMES_SCRAPE", "")
ALLOW = f"{HOME}/.config/pii-allow.txt"
FIXTURES = os.environ.get("NAMES_FIXTURES", "tests/known-fixtures.txt")
SKIP_SUFFIX = (".png", ".jpg", ".gguf", ".lock", ".min.js", ".map")
FLOOR = 0.6


def run(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout


def permitted():
    """Invented names, and anything deliberately allowed."""
    out = set()
    root = run("git", "rev-parse", "--show-toplevel").strip()
    fixtures = FIXTURES if os.path.isabs(FIXTURES) else f"{root}/{FIXTURES}"
    for path in (fixtures, f"{root}/tests/known-fixtures.txt", ALLOW):
        try:
            for line in open(path, encoding="utf-8"):
                body = line.split("#")[0].strip()
                if body:
                    out.add(body.casefold())
        except OSError:
            pass
    return out


def from_database():
    """Everyone, and every organization, the machine already knows about.

    A member's employer is their business as much as their name is, and an org name that came
    out of a scrape is data, not something to reach for when a test needs a company.
    """
    names, people = set(), set()
    try:
        graph = json.load(open(GRAPH, encoding="utf-8"))
        people = {n["label"] for n in graph.get("nodes", []) if n.get("kind") == "person"}
        names |= people
        # an org has to look named to count: a one-word lowercase label is an ordinary word
        names |= {n["label"] for n in graph.get("nodes", []) if n.get("kind") == "org"
                  and len(n["label"]) > 4 and n["label"][:1].isupper()}
        names |= {m["sender"] for m in (graph.get("messages") or {}).values() if m.get("sender")}
    except (OSError, ValueError):
        pass
    try:
        for line in open(SCRAPE, encoding="utf-8"):
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and row.get("sender"):
                names.add(row["sender"])
    except OSError:
        pass
    # a sender can be called something that is also an ordinary word
    common = {"contact", "team", "admin", "support", "info", "hello", "help", "sales"}
    # The length floor is for handles and org names, which are guessed at. A person the
    # graph calls a person is not a guess, and short real names exist -- Li, Bo, Ng, Wu --
    # so they keep their protection however short they are. Matching is word-bounded, which
    # is what makes that affordable.
    return {n for n in names
            if n.casefold() not in common and (n in people or len(n) > 3)}


EMAIL = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)*\.[A-Za-z]{2,}")
# RFC 2606 / 6761 reserve these for documentation and tests; nobody can be reached at them
RESERVED_DOMAIN = re.compile(r"(?:^|\.)(?:example|test|invalid|localhost)$|^example\.(?:com|net|org)$", re.I)
UUIDISH = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
PHONE = re.compile(r"\+?\d[\d ().-]{8,}\d")
DATEISH = re.compile(r"^\d{4}[-/]\d{1,2}[-/]\d{1,2}$")
TIMESTAMP = re.compile(r"\d{4}[-/]\d{1,2}[-/]\d{1,2}")
FRACTION = re.compile(r"\.\d{4,}")
# a recogniser reaches for anything capitalised; these shapes are code, not people
IDENTIFIER = re.compile(r"[_\[\](){}\"\n@/=]|^[a-z]+$")
# the recogniser misses names it has no feel for, so any Name-shaped pair inside a quoted
# string is flagged too. False alarms go in known-fixtures.txt once and never come back.
# A surname can be one letter. Somebody called "Jane O" slipped through this rule while it
# demanded two, and a name a heuristic cannot see is exactly the one the exact list does not
# have either. `{0,20}` costs a few false alarms on things like "Answer B"; those go in
# known-fixtures.txt once, and a missed person does not get a second chance.
NAMEISH = re.compile(r"[\"\'`]([A-Z][a-z]{1,20}(?:\s+[A-Z][\w\'’.-]{0,20}){1,3})[\"\'`]")
# Geography is name-shaped too -- "North Carolina", "Colorado River", "San Francisco" -- and
# a gazetteer or a geocoder's tests are full of it. A pair whose first word is a direction or
# a place prefix, or whose last word is a place kind, is a place, not a person. A person can
# be called North West; the exact list from the graph still catches anyone it holds.
PLACE_FIRST = {"north", "south", "east", "west", "new", "old", "upper", "lower", "san", "santa",
               "los", "las", "saint", "st.", "fort", "port", "mount", "lake", "cape", "united",
               "the", "greater", "central"}
PLACE_LAST = {"county", "river", "city", "island", "islands", "bay", "area", "kingdom", "states",
              "emirates", "beach", "lake", "valley", "park", "street", "road", "avenue",
              "mountain", "mountains", "hills", "falls", "springs", "harbor", "harbour",
              "coast", "province", "republic", "region", "district", "township", "heights"}


# A job title is name-shaped too -- "Software Engineer", "Account Manager" -- and a role
# catalogue is a page of them. A pair whose last word names a role is a role, not a person.
ROLE_LAST = {"engineer", "manager", "designer", "analyst", "specialist", "writer", "marketer",
             "executive", "representative", "partner", "director", "lead", "officer",
             "scientist", "researcher", "developer", "administrator", "coordinator", "recruiter",
             "accountant", "counsel", "architect", "consultant", "technician", "assistant",
             "associate", "intern", "head", "chief", "professor", "fellow", "student", "lecturer",
             "maintainer", "contributor", "volunteer", "moderator", "founder", "president",
             "responder", "worker", "agent", "buyer", "clerk", "auditor", "nurse", "guide",
             "treasurer", "secretary", "controller", "strategist", "planner", "operator",
             "generalist", "advocate", "evangelist", "trainer", "educator", "librarian",
             "support", "success", "operations", "sales", "marketing", "finance", "legal",
             "security", "reliability", "quality", "product", "platform", "data", "people"}


def is_role(body):
    return body.casefold().split()[-1].strip(".,") in ROLE_LAST


def is_place(body):
    words = body.casefold().split()
    return words[0] in PLACE_FIRST or words[-1].strip(".,") in PLACE_LAST


def contacts(line, allowed):
    for found in EMAIL.finditer(line):
        # an address on the allow list is the author's own, and their own work may say so
        domain = found.group(0).rsplit("@", 1)[-1]
        if RESERVED_DOMAIN.search(domain):
            continue
        if "noreply" not in found.group(0) and found.group(0).casefold() not in allowed:
            yield "an email address", found.group(0)
    uuids = [m.group(0) for m in UUIDISH.finditer(line)]
    for found in PHONE.finditer(line):
        text = found.group(0)
        if not (text.startswith("+") or "(" in text or "-" in text):
            continue
        # the middle of a uuid is digits and dashes too
        if any(text in u for u in uuids):
            continue
        if text.count(".") > 1 or DATEISH.match(text) or FRACTION.search(text):
            continue
        # a timestamp is digits and dashes and so is a phone number, but no phone number has a
        # year-month-day in it
        if TIMESTAMP.search(text):
            continue
        if 7 <= sum(c.isdigit() for c in text) <= 15:
            yield "something shaped like a phone number", text


def recogniser():
    """The small model: a fifth of a second to load, and it knows a name it has never seen."""
    try:
        from presidio_analyzer import AnalyzerEngine
        from presidio_analyzer.nlp_engine import NlpEngineProvider
    except ImportError:
        return None
    provider = NlpEngineProvider(nlp_configuration={
        "nlp_engine_name": "spacy",
        "models": [{"lang_code": "en", "model_name": "en_core_web_sm"}]})
    return AnalyzerEngine(nlp_engine=provider.create_engine(), supported_languages=["en"])


staged = [f for f in run("git", "diff", "--cached", "--name-only", "--diff-filter=ACMR").split("\n")
          if f and not f.endswith(SKIP_SUFFIX)]
if not staged:
    sys.exit(0)

allowed = permitted()
known = {n for n in from_database() if n.casefold() not in allowed}
engine = recogniser()
bad = []

for path in staged:
    blob = run("git", "show", f":{path}")
    if not blob or "\0" in blob[:2048]:
        continue
    for i, line in enumerate(blob.split("\n"), 1):
        for name in known:
            if re.search(rf"(?<![\w.]){re.escape(name)}(?![\w])", line, re.I):
                bad.append((path, i, f"{name!r} is someone in the data"))
        for what, text in contacts(line, allowed):
            bad.append((path, i, f"{what}: {text}"))
    # the shape rule is for names quoted in source. A data file is full of quoted proper
    # nouns by design — a map's countries, a gazetteer's towns — and none of them are people.
    # A file may say it is a catalogue of invented labels -- job titles, event names, a role
    # table -- and switch the shape rule off for itself. The exact list from the graph and the
    # recogniser still run over it, so a real name in a catalogue is still caught.
    shapes_off = "no-real-names: shapes off" in blob[:2000]
    for i, line in enumerate([] if shapes_off or path.endswith((".json", ".csv", ".geojson")) else blob.split("\n"), 1):
        for found in NAMEISH.finditer(line):
            body = found.group(1).strip()
            if body.casefold() not in allowed and not is_place(body) and not is_role(body):
                bad.append((path, i, f"{body!r} is shaped like a name"))
    if engine is None:
        continue
    for hit in engine.analyze(text=blob, language="en"):
        if hit.entity_type != "PERSON" or hit.score < FLOOR:
            continue
        body = blob[hit.start:hit.end].strip().strip("’‘'\"`,.:; ")
        # a person has a given name and a family name; one CamelCase token is a class
        if not body or " " not in body or body.casefold() in allowed or IDENTIFIER.search(body):
            continue
        bad.append((path, blob.count("\n", 0, hit.start) + 1, f"{body!r} reads as a person"))

if engine is None:
    print("pre-commit: presidio is not installed, so only known names are checked", file=sys.stderr)

if bad:
    seen, unique = set(), []
    for row in bad:
        if row not in seen:
            seen.add(row)
            unique.append(row)
    print("pre-commit: refusing to commit a person's details", file=sys.stderr)
    for path, line, why in unique[:25]:
        print(f"           {path}:{line}  {why}", file=sys.stderr)
    if len(unique) > 25:
        print(f"           ...and {len(unique) - 25} more", file=sys.stderr)
    print(f"           invent the data. If the name is made up, add it to {FIXTURES}.",
          file=sys.stderr)
    sys.exit(1)
PY
exit 0
