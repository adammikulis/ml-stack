#!/bin/sh
# Refuse any commit that carries a person's name, handle or contact details.
#
# Nothing in this repository may name a person. Test data is invented, always.
#
# The detector is `ml_stack.redact.hook`. Two detectors, because each misses what the other
# catches:
#   - Presidio's recogniser reads every staged file and refuses a person it finds, including
#     one it has never seen before. Where the recogniser has no feel for a name, a shape rule
#     catches anything that looks like one inside a quoted string.
#   - An exact list read from a local database catches lowercase handles that a recogniser
#     does not read as names. Neither list is written down: the names are read at commit time.
#
# Configuration, all by environment variable so another repo can wrap this file:
#   NAMES_GRAPH     a graph JSON; its person and org entries and its message senders
#                   are refused (default: none)
#   NAMES_SCRAPE    a JSONL file whose "sender" fields are refused (default: none)
#   NAMES_FIXTURES  the allow-list of invented names (default: tests/known-fixtures.txt,
#                   relative to the repo root; an absolute path is used as given)
#   PYTHON          the interpreter to run (default: python3)
#
# Where that Python has no ml-stack installed, the source tree beside this script is used:
# `$0` is resolved through the .git/hooks symlink and `../../src` put on the path.
#
# Install:  scripts/install-hooks.sh
#           pip install -e '.[privacy]' && python -m spacy download en_core_web_sm
# Override: SKIP_NAME_CHECK=1 git commit ...   only after reading what it flagged.

[ -n "$SKIP_NAME_CHECK" ] && exit 0

PY="${PYTHON:-python3}"

exec "$PY" -c '
import os, sys
try:
    from ml_stack.redact.hook import main
except ImportError:
    here = os.path.dirname(os.path.realpath(sys.argv[1]))
    sys.path.insert(0, os.path.normpath(os.path.join(here, "..", "..", "src")))
    for name in [m for m in sys.modules if m == "ml_stack" or m.startswith("ml_stack.")]:
        del sys.modules[name]
    from ml_stack.redact.hook import main
sys.exit(main(sys.argv[2:]))
' "$0" "$@"
