#!/bin/sh
# Every pre-commit check, in order: no agent commit in the primary checkout, no data file, no person's name, no growth in any budget,
# and no raised number in budgets.json.
set -e

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
here=$(cd "$(dirname "$self")" && pwd)

"${PYTHON:-python3}" "$here/primary-only"
"${PYTHON:-python3}" "$here/no-data-files"
"$here/no-real-names" "$@"
"${PYTHON:-python3}" "$here/budgets" "$@"
"${PYTHON:-python3}" "$here/budgets-only-fall" "$@"
