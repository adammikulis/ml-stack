#!/bin/sh
# Every pre-commit check, in order: no person's name, no growth in any budget, and no
# raised number in budgets.json.
set -e

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
here=$(cd "$(dirname "$self")" && pwd)

"$here/no-real-names" "$@"
"$here/budgets" "$@"
"$here/budgets-only-fall" "$@"
